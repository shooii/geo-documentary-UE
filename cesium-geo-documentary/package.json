{
  "name": "cesium-geo-documentary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "geo-video": "tsx scripts/geo-video.ts",
    "doctor": "tsx scripts/geo-video.ts doctor",
    "cesium:serve": "tsx apps/cesium-player/server.ts",
    "studio": "tsx apps/ue-player/dev.ts",
    "workbook": "tsx scripts/project-workbook.ts",
    "capture": "tsx .agents/skills/cesium-geo-documentary/scripts/capture-frames.ts",
    "cover": "tsx .agents/skills/cesium-geo-documentary/scripts/generate-video-cover.ts",
    "test": "tsx --test tests/*.test.ts apps/cesium-player/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "hf": "hyperframes",
    "hf:lint": "hyperframes lint apps/video-compositor",
    "hf:check": "hyperframes check apps/video-compositor --samples 20",
    "hf:inspect": "hyperframes check apps/video-compositor --samples 20",
    "workspace:prune": "tsx .agents/skills/cesium-geo-documentary/scripts/prune-workspace.ts",
    "studio:web": "tsx apps/studio/server.ts",
    "ue:build": "pwsh -NoProfile -File scripts/ue-build.ps1",
    "ue:serve": "tsx apps/ue-player/server.ts",
    "ue:signalling": "tsx apps/ue-player/signalling.ts",
    "ue:capture": "tsx apps/ue-player/capture.ts"
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.7": "^0.3.2",
    "@epicgames-ps/lib-pixelstreamingsignalling-ue5.7": "^0.5.0",
    "cesium": "1.143.0",
    "earcut": "^3.2.4",
    "gsap": "3.13.0",
    "undici": "^8.12.3",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "hyperframes": "0.7.72",
    "playwright": "1.62.0",
    "sharp": "0.34.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
